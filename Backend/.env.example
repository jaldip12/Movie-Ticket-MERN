# Copy this file to .env and fill in real values.

# MongoDB connection string (do NOT include the db name — code appends "/ticket-booking")
# Local Mongo:    mongodb://127.0.0.1:27017
# Mongo Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=

# Secret used to sign JWT login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Backend server port
PORT=3100

# Frontend origin (must match exactly, no trailing slash). Required for CORS + cookies.
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
